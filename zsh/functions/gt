#!/usr/bin/env zsh
# "Smart alias" for "git switch".

# Logic flow:
# If the branch exists in neither refs/heads (local) nor refs/remotes (upstream),
# then create it while switching to it.
# Otherwise, switch to it, forcing --guess mode to avoid needing to qualify it
# with the name of the remote. --guess automatically sets up tracking when needed.
if (( $# == 1 )) && [[ $1 != -* ]] && \
     [[ -z $(git for-each-ref --count=1 --format=1 \
        "refs/heads/$1" "refs/remotes/*/$1" 2>/dev/null) ]]; then
  git switch --create "$1"
else
  git switch --guess "${@:--}"
fi

compdef _git gt=git-switch
